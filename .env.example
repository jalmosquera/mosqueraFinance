POSTGRES_USER=mosquera_finance
POSTGRES_PASSWORD=replace-with-a-long-random-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_PORT=8080
GUNICORN_WORKERS=2
